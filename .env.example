# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Sastrybalm SFA"
SECRET_KEY=change-this-to-a-long-random-string-in-production

# ── Database ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
DB_HOST=db
DB_PORT=3306
DB_USER=sastrybalm_user
DB_PASSWORD=sastrybalm_password
