# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Safar SFA"
ENVIRONMENT=development
SECRET_KEY=<generate-a-unique-random-value-of-at-least-32-characters>
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SECURE_COOKIES=false
ENABLE_API_DOCS=true

# ── Database ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=<generate-a-unique-random-database-root-password>
DB_HOST=db
DB_PORT=3306
DB_USER=safar_user
DB_PASSWORD=<generate-a-unique-random-application-database-password>
DB_NAME=safar_db
BACKUP_ENCRYPTION_KEY=<generate-an-independent-random-value-of-at-least-32-characters>

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Email / OTP delivery ──────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<smtp-account>
SMTP_PASSWORD=<generate-or-provision-a-rotated-smtp-password>
SMTP_FROM=noreply@example.com
